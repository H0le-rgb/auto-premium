{
  "name": "auto-premium-showcase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "test:e2e": "npm run build && playwright test --project=chromium --project=webkit",
    "test:e2e:ui": "npm run build && playwright test --ui --project=chromium --project=webkit",
    "test:e2e:chromium": "npm run build && playwright test --project=chromium",
    "test:e2e:webkit": "npm run build && playwright test --project=webkit",
    "test:e2e:firefox": "npm run build && playwright test --project=firefox"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
